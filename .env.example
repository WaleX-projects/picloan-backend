# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pickloan

# Supabase Configuration (for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Nova AI Service Configuration (for document extraction)
NOVA_API_KEY=your-nova-api-key

# Application Environment
NODE_ENV=development

# PostgreSQL Configuration (for docker-compose)
POSTGRES_DB=pickloan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin Configuration (for docker-compose)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# API Configuration
API_PORT=8000